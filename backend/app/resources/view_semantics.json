      "HastaId2": "İkincil hasta tanımlayıcısı (hasta no).",
      "Uyruk": "Hastanın uyruğu / ülke adı.",
      "BolumId": "Bölüm kimlik numarası (ID).",
      "DoktorId": "Doktor kimlik numarası (ID).",
      "HizmetAdi": "Verilen hizmetin adı.",
      "ProtokolIslemState": "Muayene/protokol işlem durumu (sayısal kod).",
      "KategoriAdi": "Randevu kategorisi adı.",
      "GenelRandevuKaynakAdi": "Randevu kaynağı: çoğunlukla doktor adı olabilir ancak başka kaynaklar da (cihaz, oda, birim) içerebilir. Sadece doktor varsaymayın.",
      "GenelRandevuBolumAdi": "Raporlamada kullanılan pratik bölüm adı. Bölüm bazlı analizlerde bu alanı kullan.",
      "ProtokolAcilisTarihi": "Protokol açılış / kabul tarihi (smalldatetime).",
      "SubeAdi": "Şube (hastane birimi) adı.",
      "CreatedDate": "Randevu kaydının oluşturulma (kayıt) tarihi."
    },
    "concepts": {
      "Doctor": {
        "terms": [
          "doktor",
          "hekim",
          "uzman",
          "doktorlara gore",
          "hekimlere gore"
        ],
        "column": "GenelRandevuKaynakAdi",
        "note": "Randevu kaynağı; kullanıcı 'doktor/hekim' dediğinde bu sütun kullanılır. RandevuyuVeren veya HastaAdi ile karıştırılmaz."
      },
      "Creator": {
        "terms": [
          "randevuyu veren",
          "randevu veren",
          "olusturan",
          "kaydeden",
          "randevuyu acan",
          "randevuyu verenlere gore",
          "olusturanlara gore"
        ],
        "column": "RandevuyuVeren",
        "note": "Randevuyu oluşturan/atayan kişi veya sistem; doktor değildir."
      },
      "Department": {
        "terms": [
          "bolum",
          "brans",
          "klinik",
          "poliklinik",
          "servis",
          "branslara gore",
          "kliniklere gore"
        ],
        "column": "GenelRandevuBolumAdi",
        "note": "Raporlamada kullanılan pratik bölüm adı; KategoriAdi değildir."
      },
      "Branch": {
        "terms": [
          "sube",
          "hastane",
          "lokasyon",
          "subelere gore",
          "lokasyonlara gore"
        ],
        "column": "SubeAdi",
        "note": "Şube / hastane lokasyonu; bölüm (GenelRandevuBolumAdi) değildir."
      },
      "Patient": {
        "terms": [
          "hasta"
        ],
        "column": "HastaId",
        "columns": [
          "HastaId",
          "HastaAdi",
          "HastaSoyadi"
        ],
        "note": "Hasta sayımı HastaId üzerinden yapılır; kimlik/iletişim alanları varsayılan olarak seçilmez."
      },
      "AppointmentStatus": {
        "terms": [
          "randevu durumu",
          "durum"
        ],
        "column": "RandevuDurumu"
      },
      "AppointmentType": {
        "terms": [
          "randevu tipi",
          "randevu turu",
          "tip",
          "tur"
        ],
        "column": "RandevuTipiAdi"
      },
      "Service": {
        "terms": [
          "hizmet",
          "hizmet adi",
          "hizmete gore",
          "islem adi",
          "hizmetlere gore",
          "hizmet bazinda"
        ],
        "column": "HizmetAdi",
        "note": "Verilen hizmetin adı; bölüm (GenelRandevuBolumAdi) veya kategori (KategoriAdi) değildir."
      },
      "Category": {
        "terms": [
          "kategori",
          "kategoriye gore",
          "kategorilere gore",
          "kategori bazinda"
        ],
        "column": "KategoriAdi",
        "note": "Randevu kategorisi; bölüm değildir."
      },
      "Nationality": {
        "terms": [
          "uyruk",
          "ulke",
          "yabanci hasta",
          "uyruguna gore",
          "uyruklara gore",
          "uyruk bazinda"
        ],
        "column": "Uyruk",
        "note": "Hastanın uyruğu / ülke adı."
      },
      "Gender": {
        "terms": [
          "cinsiyet",
          "kadin erkek",
          "kadin ve erkek",
          "cinsiyete gore",
          "cinsiyet bazinda"
        ],
        "column": "CinsiyetId",
        "note": "Cinsiyet kodu: 'E', 'K', 'D'. Okunabilir etiket kolonu yoktur; değerler kod olarak filtrelenir."
      },
      "AgeGroup": {
        "terms": [
          "yas",
          "yas grubu",
          "yas gruplari",
          "yas dagilimi",
          "dogum tarihi"
        ],
        "column": "DogumTarihi",
        "note": "Yaş DogumTarihi'nden türetilir: (DATEDIFF(year, DogumTarihi, GETDATE()) / 10) * 10 ile 10'luk gruplar. Ham doğum tarihiyle gruplanmaz."
      },
      "ProtocolState": {
        "terms": [
          "protokol durumu",
          "protokol islem durumu",
          "islem durumu",
          "muayene durumu"
        ],
        "column": "ProtokolIslemState",
        "note": "Sayısal kod; kod-anlam eşlemesi DOĞRULANMAMIŞTIR. Kırılım verilebilir ama koddan gerçekleşme/iptal çıkarımı yapılmaz."
      },
      "AppointmentDuration": {
        "terms": [
          "randevu suresi",
          "sure",
          "kac dakika",
          "muayene suresi"
        ],
        "column": "RandevuSuresi",
        "note": "Planlanan süre (dakika). BitisTarihi-BaslangicTarihi farkıyla aynı olmayabilir; fiili süre ayrı bir ölçüdür."
      }
    },
    "date_semantics": {
      "default_column": "BaslangicTarihi",
      "rules": [
        {
          "column": "ProtokolAcilisTarihi",
          "terms": [
            "protokol"
          ],
          "note": "'Protokolü bugün açılanlar' protokol açılış tarihini kullanır."
        },
        {
          "column": "CreatedDate",
          "terms": [
            "olusturulan",
            "olusturulma",
            "olusturma",
            "olusturuldu",
            "kayit",
            "kayit tarihi",
            "kaydedilen",
            "kaydedildi",
            "eklenen"
          ],
          "note": "'Bugün oluşturulan randevular' kayıt tarihini (CreatedDate) kullanır."
        }
      ]
    },
    "measures": {
      "distinct_patients": {
        "terms": [
          "farkli hasta",
          "tekil hasta",
          "kac hasta",
          "hasta sayisi"
        ],
        "expression": "COUNT(DISTINCT HastaId)",
        "note": "Farklı hasta sayısı; randevu sayısı (COUNT(*)) ile karıştırılmaz."
      },
      "appointment_count": {
        "terms": [
          "randevu sayisi",
          "randevu sayilari",
          "randevularin sayisi",
          "randevu adedi",
          "randevularin adedi",
          "kac randevu"
        ],
        "expression": "COUNT(*)",
        "note": "Randevu adedi; hasta sayısı ile karıştırılmaz."
      }
    },
    "named_cohorts": {
      "yabanci": {
        "column": "Uyruk",
        "operator": "<>",
        "value": "Türkiye",
        "aliases": [
          "turk olmayan",
          "turkiye disindaki"
        ],
        "label": "Yabancı uyruklu",
        "note": "'Yabancı' = ana ülke DIŞINDAKİ her uyruk. Ana ülke bir kurulum varsayımıdır; başka bir ülkede çalıştırılacaksa 'value' güncellenmelidir."
      },
      "yerli": {
        "column": "Uyruk",
        "operator": "=",
        "value": "Türkiye",
        "label": "T.C. uyruklu"
      }
    },
    "status_filters": {
      "gerceklesen": "Gerçekleşti",
      "gerceklesti": "Gerçekleşti",
      "gelmeyen": "Gelmedi",
      "gelmedi": "Gelmedi",
      "gelmeme": "Gelmedi",
      "no show": "Gelmedi",
