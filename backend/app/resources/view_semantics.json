    "columns": {
      "Id": "Randevu kaydının benzersiz kimliği.",
      "BaslangicTarihi": "Randevu başlangıç tarihi ve saati (datetime).",
      "BitisTarihi": "Randevu bitiş tarihi ve saati (datetime).",
      "RandevuSuresi": "Randevu süresi (dakika).",
      "RandevuDurumu": "Randevu durumu; okunabilir metin. Doğrulanmış değerler: 'Beklemede', 'Gelmedi', 'Gerçekleşti', 'Giriş Yapılmış', 'İşlem Sürmekte'. 'İptal' değeri veride bulunmaz. Değerleri tam olarak saklandığı gibi filtrele.",
      "HastaId": "Hastanın kimlik numarası (iç sistem ID).",
      "RandevuTipiAdi": "Randevu tipi; okunabilir metin. Bilinen değerler: 'Poliklinik', 'Ameliyat', 'Radyoloji', 'Kemoterapi' (başka değerler de olabilir).",
      "RandevuyuVeren": "Randevuyu oluşturan/atayan kişi veya sistem. DOKTOR DEĞİLDİR.",
